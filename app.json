{
  "expo": {
    "name": "物品管家",
    "slug": "item-keeper",
    "version": "1.6.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.itemkeeper.app",
      "buildNumber": "8"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D5EBE5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.itemkeeper.app",
      "versionCode": 8
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "扫描商品条码和设备序列号需要使用相机",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#0D6B5E"
        }
      ],
      "expo-font",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "根据你所在的位置给办公点起名，只在你点「用当前位置起名」时使用"
        }
      ]
    ],
    "scheme": "itemkeeper"
  }
}

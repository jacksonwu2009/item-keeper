{
  "expo": {
    "name": "物品管家",
    "slug": "item-keeper",
    "version": "1.10.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.itemkeeper.app",
      "buildNumber": "13"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#D5EBE5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA"
      ],
      "package": "com.itemkeeper.app",
      "versionCode": 38
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "扫描条码、拍包装识别文字需要使用相机",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "从相册选包装照片识别文字，照片只在手机上处理",
          "cameraPermission": "扫描条码、拍包装识别文字需要使用相机",
          "microphonePermission": false
        }
      ],
      "./modules/label-ocr/app.plugin.js",
      [
        "expo-notifications",
        {
          "color": "#0D6B5E"
        }
      ],
      "expo-font",
      "expo-sharing",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "根据你所在的位置给办公点起名，只在你点「用当前位置起名」时使用"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F2F4F1",
          "dark": {
            "backgroundColor": "#101512"
          }
        }
      ]
    ],
    "scheme": "itemkeeper",
    "backgroundColor": "#F2F4F1"
  }
}
